{
  "name": "enohacker",
  "displayName": "EnoHacker",
  "description": "EnoHacker - pi-coding-agent powered sidebar for VS Code",
  "version": "0.0.1",
  "publisher": "2207LHI",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:enohacker.sidebarView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "enohacker-sidebar",
          "title": "EnoHacker",
          "icon": "media/enohacker.svg"
        }
      ]
    },
    "views": {
      "enohacker-sidebar": [
        {
          "id": "enohacker.sidebarView",
          "name": "EnoHacker",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "enohacker.showSidebar",
        "title": "Show EnoHacker"
      },
      {
        "command": "enohacker.openPiTerminal",
        "title": "Start pi in Terminal"
      },
      {
        "command": "enohacker.startPi",
        "title": "Start pi (RPC) headless"
      },
      {
        "command": "enohacker.stopPi",
        "title": "Stop pi"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "EnoHacker",
      "properties": {
        "enohacker.piPath": {
          "type": "string",
          "default": "",
          "description": "Path to a local 'pi' CLI js file (cli.js). If set, EnoHacker will prefer this CLI over a global 'pi' command. Supports ~ for home and workspace-relative paths."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository --allow-star-activation"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "file:../pi-mono/packages/coding-agent",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.4"
  }
}
